# --- Google Sheets (compte de service) --------------------------------------
# Deux façons de fournir les identifiants, au choix.
#
# 1) Le JSON complet sur une seule ligne — pratique en hébergement :
GOOGLE_SERVICE_ACCOUNT_JSON=
# 2) Ou le chemin du fichier téléchargé depuis Google Cloud — pratique en local :
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ID présent dans l'URL : docs.google.com/spreadsheets/d/<ID>/edit
# Le Sheet doit être partagé avec l'adresse du compte de service (droit Éditeur).
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_RANGE=Leads!A:G

# --- Meta -------------------------------------------------------------------
# Jeton de Page longue durée (voir README). Sert à la fois aux leads et à
# la publication Instagram.
META_PAGE_ACCESS_TOKEN=
# ID de la Page Facebook liée au compte Instagram.
META_PAGE_ID=112795731747614
# Chaîne secrète de ton choix, à reporter à l'identique dans le Dashboard Meta.
META_VERIFY_TOKEN=
# App ID (Paramètres > Général) — requis par setup-meta.js.
META_APP_ID=
# App Secret (Paramètres > Général). Sans lui, le serveur accepte n'importe
# quelle requête sur /webhook : à renseigner avant toute mise en production.
META_APP_SECRET=
# Version de la Graph API appelée.
GRAPH_API_VERSION=v26.0

# Optionnel : ID du compte Instagram professionnel. Déduit de la Page si absent.
# IG_USER_ID=

PORT=3000
